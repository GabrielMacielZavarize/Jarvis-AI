# Backend principal do Jarvis: gemini-realtime | openai-realtime | openai-compatible-pipeline
JARVIS_BACKEND=gemini-realtime

# Ative a ferramenta de email somente quando quiser usá-la
JARVIS_ENABLE_EMAIL_TOOL=false

# Lista CSV de destinatários autorizados. Se ficar vazia, apenas GMAIL_USER será permitido.
JARVIS_ALLOWED_EMAILS=

# Controle do computador: abrir/fechar apps, sites, YouTube/streaming, abas, mídia, volume.
# Só ações seguras e visíveis: nada de terminal, desinstalação ou leitura de arquivos.
JARVIS_ENABLE_PC_CONTROL=false

# Instalar aplicativos pelo winget (winget e Microsoft Store). Cada instalação só roda depois
# que você diz "confirmar instalação <código>". Nunca desinstala nada.
JARVIS_ENABLE_APP_INSTALL=false

# Controle de janelas por gestos das mãos (webcam + MediaPipe). Liga a ferramenta de voz
# gesture_control ("Jarvis, liga os gestos"). Os quadros da câmera ficam só na memória local.
# Também dá para subir já ligado com: python jarvis.py --gestures
JARVIS_ENABLE_GESTURES=false

# Sua cidade: origem das conexões no globo 3D e cidade padrão para clima/horário (ex.: Criciúma)
JARVIS_HOME_CITY=

# Experimental: pede ao Gemini para transcrever sua fala em pt-BR com vocabulário extra
# (Jarvis, Claude, Criciúma...). Se o Jarvis parar de responder, volte para false.
JARVIS_TRANSCRIPTION_HINTS=false

# Credenciais LiveKit para os comandos dev/start/connect
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Google Gemini Live — chave gratuita em https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key
# gemini-3.8-live: modelo Live estável, disponível no plano gratuito
GOOGLE_MODEL=gemini-3.8-live
GOOGLE_VOICE=Charon

# OpenAI Realtime
OPENAI_API_KEY=your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin

# Endpoints compatíveis com OpenAI
OPENAI_BASE_URL=
OPENAI_LLM_MODEL=gpt-4.1
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash

# Gmail App Password para o fluxo seguro de email
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
