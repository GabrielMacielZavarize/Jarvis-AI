# Backend principal do Jarvis: gemini-realtime | openai-realtime | openai-compatible-pipeline
JARVIS_BACKEND=gemini-realtime

# Ative a ferramenta de email somente quando quiser usá-la
JARVIS_ENABLE_EMAIL_TOOL=false

# Lista CSV de destinatários autorizados. Se ficar vazia, apenas GMAIL_USER será permitido.
JARVIS_ALLOWED_EMAILS=

# Controle do computador: abrir/fechar apps, sites, YouTube/streaming, abas, mídia, volume.
# Só ações seguras e visíveis: nada de terminal, desinstalação ou leitura de arquivos.
JARVIS_ENABLE_PC_CONTROL=false

# Instalar aplicativos pelo winget (winget e Microsoft Store). Cada instalação só roda depois
# que você diz "confirmar instalação <código>". Nunca desinstala nada.
JARVIS_ENABLE_APP_INSTALL=false

# Webcam: o Jarvis olha pela câmera só quando você pede ("o que você está vendo?") e mostra o
# feed no HUD. Nada é gravado; o quadro só vai para o Google quando ele olha a seu pedido.
JARVIS_ENABLE_CAMERA=false
# Qual webcam usar: parte do nome ou o índice. Vazio = a primeira que não seja infravermelha.
JARVIS_CAMERA=
# Controle de janelas por gestos das mãos (webcam + MediaPipe). Liga a ferramenta de voz
# gesture_control ("Jarvis, liga os gestos"). Os quadros da câmera ficam só na memória local.
# Também dá para subir já ligado com: python jarvis.py --gestures
JARVIS_ENABLE_GESTURES=false
# Mouse e teclado (MOU-20): o Jarvis clica, digita, rola e usa atalhos por você. Um print da tela
# vai para o Gemini (JARVIS_COMPUTER_USE_MODEL) achar onde clicar. Recusa senhas, UAC, terminais e
# configurações do sistema; cliques que enviam/compram/apagam pedem "confirmar clique <código>".
JARVIS_ENABLE_COMPUTER_USE=false
JARVIS_COMPUTER_USE_MODEL=gemini-3.8-flash
# Memória entre conversas ("lembra que...", "o que você sabe sobre mim?", "esquece isso"), guardada
# em memoria.json nesta pasta (fora do git). Nunca guarda senhas, tokens, documentos ou cartões.
JARVIS_ENABLE_MEMORY=true

# Sua cidade: origem das conexões no globo 3D e cidade padrão para clima/horário (ex.: Criciúma)
JARVIS_HOME_CITY=

# Palavra de ativação (WAK-22): diga "Jarvis" ou "hey Jarvis" e o link abre sozinho.
# Detecção 100% local (openWakeWord); nenhum áudio sai do PC antes da ativação.
JARVIS_WAKE_WORD=false
# Sensibilidade de 0.05 a 0.99: menor ativa mais fácil (e erra mais). Calibre com: python wake_word.py --test
JARVIS_WAKE_THRESHOLD=0.5
# Encerra o link após N segundos de silêncio para economizar a cota do Gemini (0 = nunca)
JARVIS_WAKE_SILENCE_SECONDS=30
# Opcional: parte do nome de um microfone só para o detector (ex.: Microphone Array). Vazio = o do painel Sistema.
JARVIS_WAKE_MIC=

# Experimental: pede ao Gemini para transcrever sua fala em pt-BR com vocabulário extra
# (Jarvis, Claude, Criciúma...). Se o Jarvis parar de responder, volte para false.
JARVIS_TRANSCRIPTION_HINTS=false

# Credenciais LiveKit para os comandos dev/start/connect
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Google Gemini Live — chave gratuita em https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key
# gemini-3.8-live: modelo Live estável, disponível no plano gratuito
GOOGLE_MODEL=gemini-3.8-live
GOOGLE_VOICE=Charon

# OpenAI Realtime
OPENAI_API_KEY=your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin

# Endpoints compatíveis com OpenAI
OPENAI_BASE_URL=
OPENAI_LLM_MODEL=gpt-4.1
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash

# Gmail App Password para o fluxo seguro de email
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
