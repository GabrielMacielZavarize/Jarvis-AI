# Backend principal do Jarvis: gemini-realtime | openai-realtime | openai-compatible-pipeline
JARVIS_BACKEND=gemini-realtime

# Ative a ferramenta de email somente quando quiser usá-la
JARVIS_ENABLE_EMAIL_TOOL=false

# Lista CSV de destinatários autorizados. Se ficar vazia, apenas GMAIL_USER será permitido.
JARVIS_ALLOWED_EMAILS=

# Controle do computador: abrir/fechar apps, sites, YouTube/streaming, abas, mídia, volume.
# Só ações seguras e visíveis: nada de terminal, desinstalação ou leitura de arquivos.
JARVIS_ENABLE_PC_CONTROL=false

# Instalar aplicativos pelo winget (winget e Microsoft Store). Cada instalação só roda depois
# que você diz "confirmar instalação <código>". Nunca desinstala nada.
JARVIS_ENABLE_APP_INSTALL=false

# Webcam: o Jarvis olha pela câmera só quando você pede ("o que você está vendo?") e mostra o
# feed no HUD. Nada é gravado; o quadro só vai para o Google quando ele olha a seu pedido.
JARVIS_ENABLE_CAMERA=false
# Qual webcam usar: parte do nome ou o índice. Vazio = a primeira que não seja infravermelha.
JARVIS_CAMERA=
# Controle de janelas por gestos das mãos (webcam + MediaPipe). Liga a ferramenta de voz
# gesture_control ("Jarvis, liga os gestos"). Os quadros da câmera ficam só na memória local.
# Também dá para subir já ligado com: python jarvis.py --gestures
JARVIS_ENABLE_GESTURES=false
# Painel de gestos ("mostra o painel de gestos" ou dois dedos parados ~1 s): câmera + mapa das telas
# para arrastar janelas entre monitores com a mão. Canto: inferior-direito, inferior-esquerdo,
# superior-direito ou superior-esquerdo. Monitor: número ou nome da tela ("notebook", "2", "de cima").
JARVIS_GESTURE_PANEL_CORNER=inferior-direito
JARVIS_GESTURE_PANEL_MONITOR=notebook
JARVIS_GESTURE_PANEL_OPACITY=0.92
JARVIS_GESTURE_PANEL_SIZE=360x260
# Mouse e teclado (MOU-20): o Jarvis clica, digita, rola e usa atalhos por você. Um print da tela
# vai para o Gemini (JARVIS_COMPUTER_USE_MODEL) achar onde clicar. Recusa senhas, UAC, terminais e
# configurações do sistema; cliques que enviam/compram/apagam pedem "confirmar clique <código>".
# Liga também o modo ditado (DIT-29): "Jarvis, modo ditado" ... "fim do ditado".
JARVIS_ENABLE_COMPUTER_USE=false
JARVIS_COMPUTER_USE_MODEL=gemini-3.8-flash
# Presença (PRS-25): a webcam percebe quando você chega e sai (MediaPipe, ~2 detecções/s, quadros só na
# memória). Ao voltar depois de uns minutos fora: "Bem-vindo de volta, senhor" e um resumo do que houve.
# Precisa de JARVIS_ENABLE_CAMERA=true. Para o Jarvis reconhecer só você: python presence.py --enroll
JARVIS_PRESENCE=false
# Fora por mais que isso (minutos): pausa a mídia que estiver tocando
JARVIS_PRESENCE_AWAY_MINUTES=5
# ...e também bloqueia o PC (dá para mudar por voz: "não bloqueia quando eu sair")
JARVIS_PRESENCE_LOCK=false
# Memória entre conversas ("lembra que...", "o que você sabe sobre mim?", "esquece isso"), guardada
# em memoria.json nesta pasta (fora do git). Nunca guarda senhas, tokens, documentos ou cartões.
JARVIS_ENABLE_MEMORY=true
# Rotinas (ROT-24): "bom dia, Jarvis", "modo foco", "modo jogo", "boa noite" e as que você criar,
# guardadas em rotinas.json nesta pasta (fora do git). Também rodam sozinhas no horário agendado.
JARVIS_ENABLE_ROUTINES=true

# Google Agenda (AGD-27): "o que eu tenho hoje?", "marca dentista sexta às 15h", "desmarca a
# reunião das 10". Criar/alterar/apagar pede "confirmar agenda <código>". Login uma vez com:
# python calendar_tools.py --login (precisa do google_credentials.json; veja o README).
JARVIS_ENABLE_CALENDAR=false
# Aviso N minutos antes de cada reunião: o servidor do HUD acorda o Jarvis (abre o link) e ele avisa.
# 0 = sem aviso.
JARVIS_CALENDAR_REMINDER_MINUTES=10

# Avisos proativos (PRO-28): lembretes com hora ("me lembra amanhã às 10h de...") guardados em
# lembretes.json (fora do git) e monitores de bateria, CPU/RAM, downloads e disco. Com o link
# aberto o Jarvis fala; fechado, o importante abre o link sozinho e o resto vira aviso no HUD.
JARVIS_PROACTIVE=false
# Horário de silêncio: só o crítico fala (o resto aparece no HUD). "off" desliga. Também dá
# para mudar por voz: "Jarvis, horário de silêncio das 22h às 6h".
JARVIS_QUIET_HOURS=23:00-07:00
# Opcional: outra pasta de downloads para vigiar. Vazio = a pasta Downloads do Windows.
JARVIS_DOWNLOADS_DIR=

# Sua cidade: origem das conexões no globo 3D e cidade padrão para clima/horário (ex.: Criciúma)
JARVIS_HOME_CITY=

# Palavra de ativação (WAK-22): diga "Jarvis" ou "hey Jarvis" e o link abre sozinho.
# Detecção 100% local (openWakeWord); nenhum áudio sai do PC antes da ativação.
JARVIS_WAKE_WORD=false
# Sensibilidade de 0.05 a 0.99: menor ativa mais fácil (e erra mais). Calibre com: python wake_word.py --test
JARVIS_WAKE_THRESHOLD=0.5
# Encerra o link após N segundos de silêncio (0 = nunca: só "tchau, Jarvis" ou o botão fecham).
# Link aberto direto gasta minutos do LiveKit e cota do Gemini; use 120 ou mais se quiser economizar.
JARVIS_WAKE_SILENCE_SECONDS=0
# Opcional: parte do nome de um microfone só para o detector (ex.: Microphone Array). Vazio = o do painel Sistema.
JARVIS_WAKE_MIC=

# Experimental: pede ao Gemini para transcrever sua fala em pt-BR com vocabulário extra
# (Jarvis, Claude, Criciúma...). Se o Jarvis parar de responder, volte para false.
JARVIS_TRANSCRIPTION_HINTS=false

# Credenciais LiveKit para os comandos dev/start/connect
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Google Gemini Live — chave gratuita em https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key
# gemini-3.8-live: modelo Live estável, disponível no plano gratuito
GOOGLE_MODEL=gemini-3.8-live
# Modelos Live de reserva, em ordem. O plano gratuito limita cada modelo separadamente: quando um
# estoura a cota ou fica sobrecarregado, a conversa continua no próximo sem cair o link, e ele fica
# em pausa (modelos.json) até a cota voltar. Vazio = sem reserva. Com faturamento ativo na chave,
# confira o preço de cada um antes de deixá-lo aqui.
GOOGLE_FALLBACK_MODELS=gemini-3.1-flash-live-preview,gemini-2.5-flash-native-audio-preview-12-2025
# fallback: começa sempre pelo GOOGLE_MODEL. rotate: cada link novo começa pelo próximo da lista,
# para dividir o uso entre os modelos.
JARVIS_MODEL_ROTATION=fallback
# Silêncio (ms) que encerra a sua fala antes de o Jarvis responder. 0 = padrão do Google.
# Respostas demorando para começar: tente 500. Ele te corta no meio da frase: suba para 900.
JARVIS_END_OF_SPEECH_MS=0
# Voz do Jarvis (VOZ-30). Charon é grave e calma, a mais próxima do filme. Outras boas: Orus,
# Iapetus, Rasalgethi, Algieba, Sadaltager. Também dá para trocar por voz: "Jarvis, troca sua voz
# para Orus" (fica salvo em voz.json e vale sobre este valor; "volta pra sua voz normal" desfaz).
JARVIS_VOICE=Charon

# OpenAI Realtime
OPENAI_API_KEY=your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin

# Endpoints compatíveis com OpenAI
OPENAI_BASE_URL=
OPENAI_LLM_MODEL=gpt-4.1
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash

# Gmail App Password para o fluxo seguro de email
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
